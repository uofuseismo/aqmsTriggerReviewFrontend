# Path prefix (or absolute origin) the API is served under.
#
# Leave unset for normal development: it defaults to "/api", which the Vite
# dev proxy forwards to the backend at http://127.0.0.2:8090 (see
# vite.config.ts), and which nginx is expected to forward in production.
#
# Set it if nginx exposes the backend under a different prefix, or point it at
# an absolute origin to develop against a remote backend - note that a
# cross-origin backend would need CORS support, which aqmsDutyReviewBackend
# does not currently have.
#VITE_API_BASE_URL=/api

# Seconds between trigger-list polls. Default 120, minimum 15, 0 disables
# polling and leaves only the Refresh button.
#VITE_TRIGGERS_POLL_SECONDS=120
